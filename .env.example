# Server only. Connect Neon through Vercel Storage or set a local connection string.
# Never prefix this with VITE_ and never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# 허브 로그인(docs/hub-auth.md). 모두 서버 전용이며 VITE_ 접두사를 붙이지 않는다. 실제 값은 저장소에 커밋하지 않는다.
# 허용 메일 도메인(쉼표로 여러 개). Production·Preview 같은 값.
AUTH_ALLOWED_DOMAINS=example.test
# 코드 해시용 비밀 키(32자 이상). Production과 Preview에 서로 다른 값.
AUTH_SECRET=replace-with-32-or-more-random-characters
# Production에만: 운영 전용 계정 DB. 미리보기·로컬은 DATABASE_URL을 쓴다.
# AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Production에만: 코드 메일 발송(Gmail 앱 비밀번호). 비워 두면 미리보기·로컬은 코드를 서버 로그에 출력한다.
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM_NAME=템플릿 허브
