{
  "name": "digitalbreeding-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare:downloads": "node scripts/prepare-downloads.mjs",
    "predev": "npm run prepare:downloads",
    "prebuild": "npm run prepare:downloads",
    "dev": "vite",
    "build": "npm run test:feedback && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "sync:feedback-templates": "node scripts/sync-feedback-templates.mjs",
    "test:feedback": "node --test tests/feedback.test.mjs tests/feedback-server.test.mjs tests/feedback-api.test.mjs tests/feedback-review.test.mjs tests/feedback-templates.test.mjs tests/auth-mailer.test.mjs tests/http.test.mjs tests/rate-limit.test.mjs tests/auth-domain.test.mjs tests/auth-store.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "echarts": "^5.6.0",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.3.1",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
